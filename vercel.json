{
	"version": 2,
	"github": {
		"enabled": true,
		"autoAlias": true,
		"silent": true,
		"autoJobCancelation": true
	},
	"routes": [
		{
			"src": "/github",
			"status": 302,
			"headers": { "Location": "https://github.com/phlzas" }
		},
		{
			"src": "/linkedin",
			"status": 302,
			"headers": {
				"Location": "https://www.linkedin.com/in/omar-ahmed-0875aa2b4"
			}
		},
		{ "handle": "filesystem" },
		{
			"src": "/(.*)",
			"status": 404,
			"dest": "/404.html"
		}
	]
}
